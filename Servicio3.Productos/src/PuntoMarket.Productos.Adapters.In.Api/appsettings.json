{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Productos": { "InitializeOnStartup": true, "SeedEnabled": false },
  "ProveedoresApi": { "BaseUrl": "http://proveedores-ms:8080/" },
  "Authentication": { "Jwt": {
    "Authority": "http://keycloak:8080/realms/puntomarket",
    "Audience": "productos-api",
    "RequireHttpsMetadata": false,
    "UserIdClaim": "sub",
    "RoleClaimPaths": ["realm_access.roles", "resource_access.productos-api.roles"],
    "RoleMapping": { "Administrador": ["Administrador", "admin"], "Cajero": ["Cajero", "cajero"] }
  } }
}
