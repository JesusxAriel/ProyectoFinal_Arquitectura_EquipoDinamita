{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "clientes-salud-route": {
        "ClusterId": "clientes-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/clientes/salud"
        },
        "Transforms": [
          {
            "PathSet": "/api/salud"
          }
        ]
      },
      "clientes-route": {
        "ClusterId": "clientes-cluster",
        "Match": {
          "Path": "/api/clientes/{**catch-all}"
        }
      },
      "productos-salud-route": {
        "ClusterId": "productos-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/productos/salud"
        },
        "Transforms": [
          {
            "PathSet": "/api/salud"
          }
        ]
      },
      "productos-route": {
        "ClusterId": "productos-cluster",
        "Match": {
          "Path": "/api/productos/{**catch-all}"
        }
      },
      "proveedores-salud-route": {
        "ClusterId": "proveedores-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/proveedores/salud"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ]
      },
      "proveedores-route": {
        "ClusterId": "proveedores-cluster",
        "Match": {
          "Path": "/api/proveedores/{**catch-all}"
        }
      },
      "proveedores-raiz-route": {
        "ClusterId": "proveedores-cluster",
        "Match": {
          "Path": "/api/proveedores"
        }
      },
      "usuarios-salud-route": {
        "ClusterId": "usuarios-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/usuarios/salud"
        },
        "Transforms": [
          {
            "PathSet": "/api/salud"
          }
        ]
      },
      "usuarios-route": {
        "ClusterId": "usuarios-cluster",
        "Match": {
          "Path": "/api/usuarios/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "clientes-cluster": {
        "Destinations": {
          "clientes-ms": {
            "Address": "http://clientes-ms:8080/"
          }
        }
      },
      "productos-cluster": {
        "Destinations": {
          "productos-ms": {
            "Address": "http://productos-ms:8080/"
          }
        }
      },
      "proveedores-cluster": {
        "Destinations": {
          "proveedores-ms": {
            "Address": "http://proveedores-ms:8080/"
          }
        }
      },
      "usuarios-cluster": {
        "Destinations": {
          "usuarios-ms": {
            "Address": "http://usuarios-ms:8080/"
          }
        }
      }
    }
  }
}
