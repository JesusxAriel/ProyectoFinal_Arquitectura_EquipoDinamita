{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "clientes-salud-route": {
        "ClusterId": "clientes-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/clientes/salud"
        },
        "Transforms": [
          {
            "PathSet": "/api/salud"
          }
        ],
        "AuthorizationPolicy": "anonymous"
      },
      "clientes-route": {
        "ClusterId": "clientes-cluster",
        "Match": {
          "Path": "/api/clientes/{**catch-all}"
        },
        "AuthorizationPolicy": "TokenValido"
      },
      "productos-salud-route": {
        "ClusterId": "productos-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/productos/salud"
        },
        "Transforms": [
          {
            "PathSet": "/api/salud"
          }
        ],
        "AuthorizationPolicy": "anonymous"
      },
      "productos-route": {
        "ClusterId": "productos-cluster",
        "Match": {
          "Path": "/api/productos/{**catch-all}"
        },
        "AuthorizationPolicy": "TokenValido"
      },
      "proveedores-salud-route": {
        "ClusterId": "proveedores-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/proveedores/salud"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ],
        "AuthorizationPolicy": "anonymous"
      },
      "proveedores-route": {
        "ClusterId": "proveedores-cluster",
        "Match": {
          "Path": "/api/proveedores/{**catch-all}"
        },
        "AuthorizationPolicy": "TokenValido"
      },
      "proveedores-raiz-route": {
        "ClusterId": "proveedores-cluster",
        "Match": {
          "Path": "/api/proveedores"
        },
        "AuthorizationPolicy": "TokenValido"
      },
      "usuarios-salud-route": {
        "ClusterId": "usuarios-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/usuarios/salud"
        },
        "Transforms": [
          {
            "PathSet": "/api/salud"
          }
        ],
        "AuthorizationPolicy": "anonymous"
      },
      "usuarios-route": {
        "ClusterId": "usuarios-cluster",
        "Match": {
          "Path": "/api/usuarios/{**catch-all}"
        },
        "AuthorizationPolicy": "SoloAdministrador"
      },
      "usuarios-perfil-route": {
        "ClusterId": "usuarios-cluster",
        "Order": -1,
        "AuthorizationPolicy": "TokenValido",
        "Match": {
          "Path": "/api/usuarios/perfil"
        }
      },
      "usuarios-perfil-password-route": {
        "ClusterId": "usuarios-cluster",
        "Order": -1,
        "AuthorizationPolicy": "TokenValido",
        "Match": {
          "Path": "/api/usuarios/perfil/password"
        }
      }
    },
    "Clusters": {
      "clientes-cluster": {
        "Destinations": {
          "clientes-ms": {
            "Address": "http://clientes-ms:8080/"
          }
        }
      },
      "productos-cluster": {
        "Destinations": {
          "productos-ms": {
            "Address": "http://productos-ms:8080/"
          }
        }
      },
      "proveedores-cluster": {
        "Destinations": {
          "proveedores-ms": {
            "Address": "http://proveedores-ms:8080/"
          }
        }
      },
      "usuarios-cluster": {
        "Destinations": {
          "usuarios-ms": {
            "Address": "http://usuarios-ms:8080/"
          }
        }
      }
    }
  },
  "Authentication": {
    "Jwt": {
      "Authority": "http://keycloak:8080/realms/puntomarket",
      "RequireHttpsMetadata": true,
      "ValidateAudience": false
    }
  },
  "Keycloak": {
    "TokenEndpoint": "http://keycloak:8080/realms/puntomarket/protocol/openid-connect/token",
    "LogoutEndpoint": "http://keycloak:8080/realms/puntomarket/protocol/openid-connect/logout",
    "ClientId": "puntomarket-web",
    "TimeoutSeconds": 10
  },
  "Usuarios": {
    "BaseUrl": "http://usuarios-ms:8080/",
    "CurrentUserPath": "api/usuarios/perfil",
    "TimeoutSeconds": 10
  }
}
