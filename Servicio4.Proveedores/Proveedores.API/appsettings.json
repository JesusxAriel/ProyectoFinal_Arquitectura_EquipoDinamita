{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Swagger": { "Enabled": false },

  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "proveedores_db",
    "ProveedoresCollection": "proveedores",
    "InitializeOnStartup": true,
    "SeedEnabled": true
  },

  "Authentication": {
    "Jwt": {
      "Authority": "http://localhost:5300/realms/proveedores-dev",
      "Audience": "proveedores-api",
      "RequireHttpsMetadata": false,
      "UserIdClaim": "sub",
      "RoleClaimPaths": [ "realm_access.roles", "roles" ],
      "RoleMapping": {
        "Administrador": [ "Administrador", "admin" ],
        "Cajero": [ "Cajero", "cajero" ]
      }
    }
  },

  "ProductosApi": {
    "Enabled": false,
    "BaseUrl": "",
    "TimeoutSegundos": 5,
    "RutaConteoActivos": "api/productos/proveedor/{proveedorId}/activos/conteo"
  }
}
