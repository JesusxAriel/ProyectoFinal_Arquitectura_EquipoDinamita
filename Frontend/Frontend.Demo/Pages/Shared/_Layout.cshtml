@inject Frontend.Demo.Services.DemoPerfilSession Perfil
@{
    var login = ViewContext.RouteData.Values["page"]?.ToString() == "/Login";
    var proveedores = ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Proveedores") == true;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1E293B" />
    <title>@ViewData["Title"] · PuntoMarket</title>
    @* INTEGRACIÓN: Estilos, iconos y tipografías comunes; reutilizar estas clases en módulos nuevos sin duplicar recursos ni rediseñar Proveedores. *@
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(login ? "login-page" : "app-page")">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    @if (!login && Perfil.TienePerfil)
    {
        <header class="app-header">
            <nav class="navbar navbar-expand-md navbar-dark" aria-label="Navegación principal">
                <div class="container app-container">
                    <a class="navbar-brand brand" asp-page="/Index"><span class="brand-symbol"><i class="bi bi-shop-window" aria-hidden="true"></i></span><span>Punto<span class="brand-accent">Market</span><span class="brand-dot">.</span></span></a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navegacion" aria-controls="navegacion" aria-expanded="false" aria-label="Abrir menú"><span class="navbar-toggler-icon"></span></button>
                    <div class="collapse navbar-collapse" id="navegacion">
                        @* INTEGRACIÓN: Agregar aquí el enlace Razor al módulo de otro grupo cuando exista su página. Conservar Proveedores y adaptar la condición de módulo activo: actualmente Inicio equivale a «no Proveedores». *@
                        <div class="navbar-nav main-nav mx-md-auto">
                            <a class="nav-link @(!proveedores ? "active" : "")" aria-current="@(!proveedores ? "page" : null)" asp-page="/Index"><i class="bi bi-grid-1x2" aria-hidden="true"></i> Inicio</a>
                            <a class="nav-link @(proveedores ? "active" : "")" aria-current="@(proveedores ? "page" : null)" asp-page="/Proveedores/Index"><i class="bi bi-truck" aria-hidden="true"></i> Proveedores</a>
                        </div>
                        @* DEMO TEMPORAL: El perfil solo orienta la UI; cada API valida JWT y permisos. Sustituir este menú al integrar identidad real. *@
                        <div class="dropdown profile-menu">
                            <button class="profile-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><span class="avatar">@(Perfil.EsAdministrador ? "AD" : "CA")</span><span class="profile-copy"><strong>@Perfil.Perfil</strong><small>Perfil de demostración</small></span></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-page="/Login" asp-route-cambiar="true"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Cambiar perfil</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><form method="post" asp-page="/Logout"><button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Cerrar sesión</button></form></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }
    <main id="contenido" class="@(login ? "login-main" : "container app-container main-content")" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="app-footer @(login ? "login-footer" : "container app-container")">
        <span><span class="footer-dot"></span> PuntoMarket <span class="footer-divider">/</span> Gestión de proveedores</span>
        <span class="demo-label">DEMO TEMPORAL · Identidad de desarrollo</span>
    </footer>
    <div class="page-loading" id="page-loading" hidden role="status" aria-live="polite"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Procesando solicitud…</div>
    <script src="~/lib/bootstrap/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
