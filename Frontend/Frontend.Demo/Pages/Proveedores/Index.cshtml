@page
@model Frontend.Demo.Pages.Proveedores.IndexModel
@{ ViewData["Title"] = "Proveedores"; var editando = !string.IsNullOrWhiteSpace(Model.EditarId); }
<div class="breadcrumb-line"><a asp-page="/Index"><i class="bi bi-house" aria-hidden="true"></i> Inicio</a><i class="bi bi-chevron-right" aria-hidden="true"></i><span>Proveedores</span></div>
<section class="page-heading"><div><span class="eyebrow">TUS ALIADOS COMERCIALES</span><h1>Proveedores<span class="heading-dot">.</span></h1><p>Una buena relación empieza con todo en orden.</p></div>
@if (Model.EsAdministrador) { <a class="btn btn-primary" asp-page="/Proveedores/Index" asp-route-Nuevo="true" asp-route-Estado="@Model.Estado" asp-route-TamanoPagina="@Model.TamanoPagina" data-bs-toggle="modal" data-bs-target="#proveedorModal"><i class="bi bi-plus-lg" aria-hidden="true"></i> Añadir</a> }
</section>
@if (Model.Mensaje is not null) { <div class="alert alert-success alert-dismissible fade show" role="status"><i class="bi bi-check-circle" aria-hidden="true"></i> @Model.Mensaje<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar mensaje"></button></div> }
@if (Model.MensajeError is not null || (Model.ErrorActual is not null && !Model.AbrirModal)) { <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> @(Model.MensajeError ?? Model.ErrorActual) <a asp-page="/Proveedores/Index" asp-all-route-data="@(new Dictionary<string,string> { ["Estado"] = Model.Estado })" class="alert-link">Volver a cargar</a></div> }
<section class="directory-card provider-directory" aria-label="Directorio de proveedores">
    <div class="directory-top"><div class="directory-title"><span class="directory-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span><div><h2>Directorio de proveedores</h2><p>Información de contacto y modalidad de abastecimiento</p></div></div>@if (!Model.EsAdministrador) { <span class="read-only"><i class="bi bi-eye" aria-hidden="true"></i> Solo lectura</span> }</div>
    <div class="directory-controls">
        <nav class="state-tabs" aria-label="Estado de proveedores">
            <a class="state-tab @(!Model.VerEliminados ? "active" : "")" asp-page="/Proveedores/Index" asp-route-Estado="Activos" asp-route-TamanoPagina="@Model.TamanoPagina" aria-current="@(!Model.VerEliminados ? "page" : null)"><i class="bi bi-check-circle" aria-hidden="true"></i> Activos</a>
            <a class="state-tab @(Model.VerEliminados ? "active" : "")" asp-page="/Proveedores/Index" asp-route-Estado="Inactivos" asp-route-TamanoPagina="@Model.TamanoPagina" aria-current="@(Model.VerEliminados ? "page" : null)"><i class="bi bi-archive" aria-hidden="true"></i> Eliminados</a>
        </nav>
        <span class="directory-count">@(Model.Resultado is null ? "Sin conexión" : $"{Model.Resultado.Total} {(Model.Resultado.Total == 1 ? "proveedor" : "proveedores")} {(Model.VerEliminados ? (Model.Resultado.Total == 1 ? "eliminado" : "eliminados") : (Model.Resultado.Total == 1 ? "activo" : "activos"))}")</span>
    </div>
    <form method="get" class="search-toolbar" data-live-search data-loading>
        <input type="hidden" name="Estado" value="@Model.Estado" />
        <div class="provider-search-group"><div class="search-box"><label class="visually-hidden" for="Busqueda">Buscar por empresa, teléfono o correo</label><i class="bi bi-search" aria-hidden="true"></i><input id="Busqueda" name="Busqueda" maxlength="150" value="@Model.Busqueda" placeholder="Buscar por empresa, teléfono o correo..." autocomplete="off" /><button type="submit" class="search-submit" aria-label="Buscar"><i class="bi bi-arrow-right" aria-hidden="true"></i></button></div><button type="button" class="btn btn-primary btn-sm" data-search-clear hidden="@(string.IsNullOrEmpty(Model.Busqueda))">Limpiar</button></div>
        <div class="toolbar-options provider-filter-group"><div class="provider-filter"><label for="TamanoPagina">Mostrar</label><select id="TamanoPagina" name="TamanoPagina" class="form-select form-select-sm" data-submit-on-change>@foreach (var tamano in new[] {10,25,50,100}) { <option value="@tamano" selected="@(Model.TamanoPagina == tamano)">@tamano</option> }</select></div><div class="provider-filter"><label class="visually-hidden" for="OrdenarPor">Ordenar por</label><select id="OrdenarPor" name="Descendente" class="form-select form-select-sm sort-select" data-submit-on-change><option value="false" selected="@(!Model.Descendente)">Nombre A-Z</option><option value="true" selected="@(Model.Descendente)">Nombre Z-A</option></select></div></div>
    </form>
    <div class="alert alert-danger" data-search-error role="alert" hidden></div>
    <span class="visually-hidden" data-search-status role="status" aria-live="polite"></span>
    @if (Model.VerEliminados) { <div class="archive-note"><i class="bi bi-info-circle" aria-hidden="true"></i> Estos proveedores están desactivados. Sus datos se conservan@(Model.EsAdministrador ? " y puedes reactivarlos." : ".")</div> }
    <div class="table-responsive">
        <table class="table provider-table table-hover mb-0"><caption class="visually-hidden">Proveedores @(Model.VerEliminados ? "eliminados" : "activos")</caption><thead><tr><th scope="col">Empresa</th><th scope="col">Teléfono</th><th scope="col">Correo de referencia</th><th scope="col">Modalidad</th><th scope="col" class="text-end">Acciones</th></tr></thead><tbody>
        @if (Model.Resultado is null)
        {
            <tr><td colspan="5"><div class="empty-state"><span><i class="bi bi-cloud-slash" aria-hidden="true"></i></span><h3>No pudimos cargar los proveedores</h3><p>Comprueba la conexión con los servicios e inténtalo de nuevo.</p><a class="btn btn-outline-secondary btn-sm" asp-page="/Proveedores/Index" asp-route-Estado="@Model.Estado">Reintentar</a></div></td></tr>
        }
        else if (Model.Resultado.Items.Count == 0)
        {
            <tr><td colspan="5"><div class="empty-state"><span><i class="bi @(Model.VerEliminados ? "bi-archive" : "bi-search")" aria-hidden="true"></i></span><h3>@(!string.IsNullOrWhiteSpace(Model.Busqueda) ? "No encontramos coincidencias" : Model.VerEliminados ? "No hay proveedores eliminados" : "Tu directorio está listo para empezar")</h3><p>@(!string.IsNullOrWhiteSpace(Model.Busqueda) ? "Prueba con otra empresa, teléfono o correo." : Model.VerEliminados ? "Aquí aparecerán los proveedores que desactives." : "Añade tu primer proveedor para tener sus datos siempre a mano.")</p>@if (!string.IsNullOrWhiteSpace(Model.Busqueda)) { <a asp-page="/Proveedores/Index" asp-route-Estado="@Model.Estado" class="btn btn-outline-secondary btn-sm">Limpiar búsqueda</a> }</div></td></tr>
        }
        else
        {
            @foreach (var p in Model.Resultado.Items)
            {
                <tr data-proveedor-id="@p.Id"><td><div class="company-cell"><span class="company-avatar">@(string.IsNullOrEmpty(p.NombreEmpresa) ? "?" : p.NombreEmpresa[..1].ToUpperInvariant())</span><div><strong>@p.NombreEmpresa</strong><span class="company-status"><span class="status-dot @(p.EstaActivo ? "" : "muted")"></span>@(p.EstaActivo ? "Activo" : "Eliminado")</span></div></div></td><td><a class="contact-link" href="tel:@p.NumeroEmpresa"><i class="bi bi-telephone" aria-hidden="true"></i>@p.NumeroEmpresa</a></td><td>@if (p.CorreoReferencia is { Length: > 0 } correo) { <a class="contact-link email-link" href="mailto:@correo">@correo</a> } else { <span class="text-secondary">Sin correo</span> }</td><td><span class="mode-badge @(p.EsAutogestionado ? "self-managed" : "direct-purchase")"><i class="bi @(p.EsAutogestionado ? "bi-arrow-repeat" : "bi-bag-check")" aria-hidden="true"></i>@(p.EsAutogestionado ? "Autogestionado" : "Compra directa")</span></td><td class="text-end">
                @if (!Model.EsAdministrador) { <span class="text-secondary action-readonly" title="Perfil de consulta"><i class="bi bi-lock" aria-hidden="true"></i><span class="visually-hidden">Solo lectura</span></span> }
                else if (p.EstaActivo)
                {
                    <div class="row-actions"><a class="icon-button edit-button" asp-page="/Proveedores/Index" asp-route-EditarId="@p.Id" asp-route-Estado="@Model.Estado" asp-route-Busqueda="@Model.Busqueda" asp-route-OrdenarPor="@Model.OrdenarPor" asp-route-Descendente="@Model.Descendente" asp-route-Pagina="@Model.Pagina" asp-route-TamanoPagina="@Model.TamanoPagina" aria-label="Editar @p.NombreEmpresa" title="Editar"><i class="bi bi-pencil-square" aria-hidden="true"></i></a><button type="button" class="icon-button delete-button" data-bs-toggle="modal" data-bs-target="#eliminarModal" data-id="@p.Id" data-nombre="@p.NombreEmpresa" aria-label="Eliminar @p.NombreEmpresa" title="Eliminar"><i class="bi bi-trash3" aria-hidden="true"></i></button></div>
                }
                else
                {
                    <form method="post" asp-page-handler="Reactivar" asp-route-id="@p.Id" asp-route-Estado="Inactivos" asp-route-TamanoPagina="@Model.TamanoPagina" data-loading><button type="submit" class="btn btn-reactivate btn-sm"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reactivar</button></form>
                }
                </td></tr>
            }
        }
        </tbody></table>
    </div>
    @if (Model.Resultado is { } r)
    {
        <div class="table-footer"><span>@(r.Total == 0 ? "0 proveedores" : $"Mostrando {(long)(Model.Pagina-1)*Model.TamanoPagina+1}–{Math.Min((long)Model.Pagina*Model.TamanoPagina,r.Total)} de {r.Total} proveedores")</span>
        <nav aria-label="Paginación"><ul class="pagination mb-0"><li class="page-item @(Model.Pagina <= 1 ? "disabled" : "")"><a class="page-link" asp-all-route-data="@(new Dictionary<string,string> { ["Estado"]=Model.Estado,["Busqueda"]=Model.Busqueda??"",["TamanoPagina"]=Model.TamanoPagina.ToString(),["OrdenarPor"]=Model.OrdenarPor,["Descendente"]=Model.Descendente.ToString(),["Pagina"]=Math.Max(1,Model.Pagina-1).ToString() })" aria-label="Página anterior" tabindex="@(Model.Pagina <= 1 ? "-1" : "0")"><i class="bi bi-chevron-left" aria-hidden="true"></i></a></li>
        @foreach(var i in Model.PaginasVisibles) { <li class="page-item @(i == Model.Pagina ? "active" : "")"><a class="page-link" asp-all-route-data="@(new Dictionary<string,string> { ["Estado"]=Model.Estado,["Busqueda"]=Model.Busqueda??"",["TamanoPagina"]=Model.TamanoPagina.ToString(),["OrdenarPor"]=Model.OrdenarPor,["Descendente"]=Model.Descendente.ToString(),["Pagina"]=i.ToString() })" aria-current="@(i==Model.Pagina ? "page" : null)">@i</a></li> }
        <li class="page-item @(Model.Pagina >= r.TotalPaginas ? "disabled" : "")"><a class="page-link" asp-all-route-data="@(new Dictionary<string,string> { ["Estado"]=Model.Estado,["Busqueda"]=Model.Busqueda??"",["TamanoPagina"]=Model.TamanoPagina.ToString(),["OrdenarPor"]=Model.OrdenarPor,["Descendente"]=Model.Descendente.ToString(),["Pagina"]=(Model.Pagina+1).ToString() })" aria-label="Página siguiente" tabindex="@(Model.Pagina >= r.TotalPaginas ? "-1" : "0")"><i class="bi bi-chevron-right" aria-hidden="true"></i></a></li></ul></nav></div>
    }
</section>
<div class="directory-footnote"><i class="bi bi-shield-check" aria-hidden="true"></i> Tus proveedores, siempre organizados. Eliminar desactiva el registro y conserva sus datos.</div>
@if (Model.EsAdministrador)
{
    <div class="modal fade" id="proveedorModal" tabindex="-1" aria-labelledby="proveedorModalTitulo" aria-hidden="true" data-auto-open="@Model.AbrirModal.ToString().ToLowerInvariant()"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><span class="eyebrow">DIRECTORIO DE PROVEEDORES</span><h2 class="modal-title" id="proveedorModalTitulo">@(editando ? "Editar proveedor" : "Añadir proveedor")</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
    <form method="post" asp-page-handler="@(editando ? "Editar" : "Crear")" asp-route-id="@Model.EditarId" asp-route-Estado="@Model.Estado" asp-route-Busqueda="@Model.Busqueda" asp-route-OrdenarPor="@Model.OrdenarPor" asp-route-Descendente="@Model.Descendente" asp-route-Pagina="@Model.Pagina" asp-route-TamanoPagina="@Model.TamanoPagina" data-loading><div class="modal-body">
    @if (Model.ErrorActual is not null && Model.AbrirModal) { <div class="alert alert-danger" role="alert">@Model.ErrorActual</div> }
    <p class="form-intro">Completa los datos de tu aliado comercial. <span aria-hidden="true">*</span> Campos obligatorios.</p>
    <div class="mb-3"><label class="form-label" asp-for="Form.NombreEmpresa">Empresa <span aria-hidden="true">*</span></label><input class="form-control @(ViewData.ModelState["Form.NombreEmpresa"]?.Errors.Count > 0 ? "is-invalid" : "")" asp-for="Form.NombreEmpresa" maxlength="150" required placeholder="Nombre de la empresa" autocomplete="organization" aria-describedby="nombre-error" /><span id="nombre-error" asp-validation-for="Form.NombreEmpresa" class="invalid-feedback" aria-live="polite"></span></div>
    <div class="mb-3"><label class="form-label" asp-for="Form.NumeroEmpresa">Teléfono <span aria-hidden="true">*</span></label><input class="form-control @(ViewData.ModelState["Form.NumeroEmpresa"]?.Errors.Count > 0 ? "is-invalid" : "")" asp-for="Form.NumeroEmpresa" maxlength="20" required placeholder="Ej. 44112233" type="tel" autocomplete="tel" aria-describedby="telefono-ayuda numero-error" /><small id="telefono-ayuda" class="text-secondary">8 dígitos. Debe comenzar por 4, 6 o 7.</small><span id="numero-error" asp-validation-for="Form.NumeroEmpresa" class="invalid-feedback" aria-live="polite"></span></div>
    <div class="mb-4"><label class="form-label" asp-for="Form.CorreoReferencia">Correo de referencia <small class="text-secondary">(opcional)</small></label><input class="form-control @(ViewData.ModelState["Form.CorreoReferencia"]?.Errors.Count > 0 ? "is-invalid" : "")" asp-for="Form.CorreoReferencia" maxlength="150" type="email" placeholder="contacto@empresa.com" autocomplete="email" aria-describedby="correo-error" /><span id="correo-error" asp-validation-for="Form.CorreoReferencia" class="invalid-feedback" aria-live="polite"></span></div>
    <div class="modality-option"><div class="form-check form-switch"><input class="form-check-input" asp-for="Form.EsAutogestionado" role="switch" /><label class="form-check-label" asp-for="Form.EsAutogestionado">Proveedor autogestionado</label></div><p>Actívalo si el proveedor gestiona su propia reposición. En caso contrario, se registra como compra directa.</p></div>
    </div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-primary"><i class="bi bi-check2" aria-hidden="true"></i> @(editando ? "Guardar cambios" : "Añadir proveedor")</button></div></form></div></div></div>
    <div class="modal fade" id="eliminarModal" tabindex="-1" aria-labelledby="eliminarModalTitulo" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header border-0"><h2 class="modal-title" id="eliminarModalTitulo">Eliminar proveedor</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><form method="post" asp-page-handler="Desactivar" asp-route-Estado="@Model.Estado" asp-route-Busqueda="@Model.Busqueda" asp-route-TamanoPagina="@Model.TamanoPagina" asp-route-OrdenarPor="@Model.OrdenarPor" asp-route-Descendente="@Model.Descendente" asp-route-Pagina="@Model.Pagina" data-loading><div class="modal-body pt-0"><span class="confirmation-icon"><i class="bi bi-archive" aria-hidden="true"></i></span><p>¿Quieres eliminar a <strong data-delete-name></strong>?</p><p class="text-secondary">Se moverá a Eliminados. Sus datos se conservarán y podrás reactivarlo cuando lo necesites.</p><input type="hidden" name="id" data-delete-id /></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-danger"><i class="bi bi-trash3" aria-hidden="true"></i> Eliminar proveedor</button></div></form></div></div></div>
}
<noscript><div class="alert alert-warning mt-3">Activa JavaScript para utilizar los formularios modales. La consulta y la búsqueda siguen disponibles.</div></noscript>
@section Scripts {
    @* INTEGRACIÓN: Este módulo JS es específico del listado de Proveedores; no se carga globalmente para otros CRUD. *@
    <script type="module" src="~/js/proveedores-busqueda.mjs" asp-append-version="true"></script>
}

@section Styles { <link rel="stylesheet" href="~/css/proveedores.css" asp-append-version="true" /> }
