@page
@model Frontend.Demo.Pages.IndexModel
@{ ViewData["Title"] = "Inicio"; }
<div class="breadcrumb-line"><i class="bi bi-house" aria-hidden="true"></i><span>Inicio</span><i class="bi bi-chevron-right" aria-hidden="true"></i><span>Panel de control</span></div>
<section class="page-heading"><div><span class="eyebrow">PANEL DE CONTROL</span><h1>Resumen de proveedores<span class="heading-dot">.</span></h1><p>Todo lo que necesitas para mantener tu micromercado en movimiento.</p></div><span class="welcome-badge"><span class="status-dot"></span> @Model.PerfilActual</span></section>
<section class="welcome-card"><div><span class="welcome-icon"><i class="bi bi-sun" aria-hidden="true"></i></span><div><h2>¡Bienvenido a PuntoMarket!</h2><p>Tu red de proveedores, organizada en un solo lugar.</p></div></div><span class="welcome-caption">MENOS PASOS.<br /><strong>MÁS CONTROL.</strong></span></section>
@if (Model.ErrorActual is not null)
{
    <div class="alert alert-danger d-flex align-items-center gap-3" role="alert"><i class="bi bi-wifi-off" aria-hidden="true"></i><span>@Model.ErrorActual</span><a class="btn btn-sm btn-outline-danger ms-auto" asp-page="/Index">Reintentar</a></div>
}
<div class="row g-4 kpi-grid">
    <div class="col-md-4"><article class="kpi-card"><div class="kpi-top"><span>Total de proveedores</span><span class="kpi-icon blue"><i class="bi bi-truck" aria-hidden="true"></i></span></div><strong class="kpi-value" data-kpi="total">@(Model.Total?.ToString() ?? "—")</strong><div class="kpi-caption">Tu red de aliados comerciales</div><span class="kpi-line blue"></span></article></div>
    <div class="col-md-4"><article class="kpi-card"><div class="kpi-top"><span>Proveedores activos</span><span class="kpi-icon green"><i class="bi bi-check-circle" aria-hidden="true"></i></span></div><strong class="kpi-value" data-kpi="activos">@(Model.Activos?.ToString() ?? "—")</strong><div class="kpi-caption"><span class="status-dot"></span> Disponibles para tu operación</div><span class="kpi-line green"></span></article></div>
    <div class="col-md-4"><article class="kpi-card"><div class="kpi-top"><span>Proveedores eliminados</span><span class="kpi-icon orange"><i class="bi bi-archive" aria-hidden="true"></i></span></div><strong class="kpi-value" data-kpi="eliminados">@(Model.Eliminados?.ToString() ?? "—")</strong><div class="kpi-caption">Puedes reactivarlos cuando quieras</div><span class="kpi-line orange"></span></article></div>
</div>
<div class="section-label"><h2>Todo a un clic</h2><span>ACCESO RÁPIDO</span></div>
<a class="quick-card" asp-page="/Proveedores/Index"><span class="quick-icon"><i class="bi bi-building" aria-hidden="true"></i></span><span><strong>Gestionar proveedores</strong><small>Consulta tu directorio@(Model.PerfilActual == "Administrador" ? ", añade nuevos aliados y mantén sus datos al día." : " y encuentra la información de tus aliados comerciales.")</small></span><span class="quick-arrow"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></span></a>
<div class="home-note"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Información consultada en tiempo real al abrir este panel.</div>
