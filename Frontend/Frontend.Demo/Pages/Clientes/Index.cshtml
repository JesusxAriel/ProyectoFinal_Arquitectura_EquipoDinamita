@page
@model Frontend.Demo.Pages.Clientes.IndexModel
@{ ViewData["Title"] = "Clientes"; }
<div class="page-heading d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><span class="eyebrow">PUNTOMARKET · DEMO TEMPORAL</span><h1>Clientes</h1><p class="text-secondary">Directorio de clientes. La API aplica las reglas y permisos definitivos.</p></div><a class="btn btn-primary" asp-page="/Clientes/Index" asp-route-Nuevo="true">Añadir cliente</a></div>
@if (Model.Mensaje is not null) { <div class="alert alert-success" role="status">@Model.Mensaje</div> }
@if (Model.MensajeError is not null) { <div class="alert alert-danger" role="alert">@Model.MensajeError</div> }
@if (Model.ErrorActual is not null && !Model.AbrirModal) { <div class="alert alert-danger" role="alert">@Model.ErrorActual</div> }
<section class="directory-card client-directory" aria-label="Directorio de clientes">
<div class="directory-top"><div class="directory-title"><span class="directory-icon"><i class="bi bi-people" aria-hidden="true"></i></span><div><h2>Directorio de clientes</h2><p>Identificación y datos de contacto</p></div></div><span class="directory-count">@(Model.Resultado is null ? "Sin conexión" : $"{Model.Resultado.Total} clientes")</span></div>
<form method="get" class="search-toolbar" data-clientes-search>
 <input type="hidden" name="Descendente" value="@Model.Descendente.ToString().ToLowerInvariant()" />
 <div class="client-search-group">
  <div class="search-box"><label class="visually-hidden" for="Busqueda">Buscar clientes</label><i class="bi bi-search" aria-hidden="true"></i><input asp-for="Busqueda" maxlength="150" placeholder="Buscar clientes..." autocomplete="off" /></div>
  <button type="button" class="btn btn-primary btn-sm" data-clientes-clear hidden="@(string.IsNullOrEmpty(Model.Busqueda))">Limpiar</button>
 </div>
 <div class="toolbar-options client-filter-group">
  <div class="client-filter"><label for="Estado">Estado</label><select asp-for="Estado" class="form-select"><option value="Activos">Activos</option><option value="Inactivos">Eliminados</option><option value="Todos">Todos</option></select></div>
  <div class="client-filter"><label for="OrdenarPor">Ordenar por</label><select asp-for="OrdenarPor" class="form-select"><option value="RazonSocial">Razón social</option><option value="NitCi">NIT/CI</option></select></div>
  <div class="client-filter"><label for="TamanoPagina">Mostrar</label><select asp-for="TamanoPagina" class="form-select">@foreach (var n in new[] {10,25,50,100}) { <option value="@n">@n</option> }</select></div>
 </div>
</form>
<div class="alert alert-danger" data-search-error role="alert" hidden></div>
<span class="visually-hidden" data-search-status role="status" aria-live="polite"></span>
<div class="table-responsive"><table class="table provider-table table-hover mb-0"><caption class="visually-hidden">Clientes del directorio</caption><thead><tr><th>NIT/CI</th><th>Razón social</th><th>Contacto</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>
@if (Model.Resultado is null) { <tr><td colspan="5"><div class="empty-state"><h3>No se pudo cargar Clientes</h3><p>Compruebe la API, el Gateway y la identidad de desarrollo.</p></div></td></tr> }
else if (Model.Resultado.Items.Count == 0) { <tr><td colspan="5"><div class="empty-state"><h3>No hay coincidencias</h3><p>Pruebe otra búsqueda o estado.</p></div></td></tr> }
else { foreach (var c in Model.Resultado.Items) {
<tr><td>@c.NitCi</td><td><strong>@c.RazonSocial</strong>@if(c.EsGenerico) { <span class="badge text-bg-secondary ms-1">Genérico protegido</span> }</td><td><div>@(c.Telefono ?? "Sin teléfono")</div><small>@(c.Correo ?? "Sin correo")</small></td><td>@(c.EstaActivo ? "Activo" : "Eliminado")</td><td class="text-end"><div class="row-actions">
 <a asp-page="/Clientes/Index" asp-route-DetalleId="@c.Id" asp-route-Estado="@Model.Estado" class="icon-button" title="Ver detalles de @c.RazonSocial" aria-label="Ver detalles de @c.RazonSocial" data-cliente-detalle><i class="bi bi-eye" aria-hidden="true"></i></a>
 @if (c.EstaActivo && !c.EsGenerico) {
 <a asp-page="/Clientes/Index" asp-route-EditarId="@c.Id" asp-route-Estado="@Model.Estado" class="icon-button edit-button" title="Editar @c.RazonSocial" aria-label="Editar @c.RazonSocial"><i class="bi bi-pencil-square" aria-hidden="true"></i></a>
 @if (Model.EsAdministrador) { <button class="icon-button delete-button" title="Desactivar @c.RazonSocial" aria-label="Desactivar @c.RazonSocial" type="button" data-bs-toggle="modal" data-bs-target="#estadoClienteModal" data-cliente-id="@c.Id" data-cliente-nombre="@c.RazonSocial" data-cliente-accion="Desactivar"><i class="bi bi-trash3" aria-hidden="true"></i></button> }
 } else if (!c.EsGenerico && Model.EsAdministrador) { <button class="icon-button" title="Reactivar @c.RazonSocial" aria-label="Reactivar @c.RazonSocial" type="button" data-bs-toggle="modal" data-bs-target="#estadoClienteModal" data-cliente-id="@c.Id" data-cliente-nombre="@c.RazonSocial" data-cliente-accion="Reactivar"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button> }
</div></td></tr>
} }
</tbody></table></div>
@if (Model.Resultado is { } r) {
<div class="table-footer"><span>@r.Total clientes · Página @Model.Pagina de @Math.Max(1,r.TotalPaginas)</span><nav aria-label="Paginación de Clientes"><ul class="pagination mb-0">
@foreach(var n in new[] { Math.Max(1,Model.Pagina-1) }.Concat(Model.PaginasVisibles).Concat(new[] { Math.Min(Math.Max(1,r.TotalPaginas),Model.Pagina+1) }).Distinct()) {
 <li class="page-item @(n==Model.Pagina ? "active" : "")"><a class="page-link" aria-current="@(n==Model.Pagina ? "page" : null)" asp-page="/Clientes/Index" asp-all-route-data="@(new Dictionary<string,string> { ["Estado"]=Model.Estado,["Busqueda"]=Model.Busqueda??"",["OrdenarPor"]=Model.OrdenarPor,["Descendente"]=Model.Descendente.ToString(),["TamanoPagina"]=Model.TamanoPagina.ToString(),["Pagina"]=n.ToString() })">@n</a></li>
}</ul></nav></div>
}
</section>
<p class="directory-footnote">Desactivar conserva los datos. Administrador y Cajero pueden crear y editar clientes normales; solo Administrador puede desactivar o reactivar.</p>
<div class="modal fade" id="clienteModal" tabindex="-1" aria-labelledby="clienteModalTitulo" aria-hidden="true" data-cliente-auto-open="@Model.AbrirModal.ToString().ToLowerInvariant()"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
<div class="modal-header"><div><span class="eyebrow">DIRECTORIO DE CLIENTES</span><h2 class="modal-title" id="clienteModalTitulo">@(Model.EditarId is null ? "Añadir cliente" : "Editar cliente")</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
<form method="post" asp-page-handler="Guardar" asp-route-EditarId="@Model.EditarId" asp-route-Estado="@Model.Estado" asp-route-Busqueda="@Model.Busqueda" asp-route-OrdenarPor="@Model.OrdenarPor" asp-route-Descendente="@Model.Descendente" asp-route-TamanoPagina="@Model.TamanoPagina" asp-route-Pagina="@Model.Pagina">
<div class="modal-body">
@if(Model.ErrorActual is not null && Model.AbrirModal) { <div class="alert alert-danger" role="alert">@Model.ErrorActual</div> }
@if (ViewData.ModelState.ErrorCount > 0) { <div asp-validation-summary="All" class="text-danger" role="alert"></div> }
<p class="form-intro">* Campos obligatorios. El servidor valida todos los datos.</p>
<div class="mb-3"><label class="form-label" asp-for="Form.NitCi">NIT/CI *</label><input asp-for="Form.NitCi" placeholder="Ej. 6488615" class="form-control @(ViewData.ModelState["Form.NitCi"]?.Errors.Count>0 ? "is-invalid" : "")" maxlength="15" required inputmode="numeric" aria-describedby="nit-error" /><span id="nit-error" asp-validation-for="Form.NitCi" class="invalid-feedback" aria-live="polite"></span></div>
<div class="mb-3"><label class="form-label" asp-for="Form.RazonSocial">Razón social *</label><input asp-for="Form.RazonSocial" placeholder="Ej. JUAN PEREZ VARGAS o EMPRESA LOS ANDES S.R.L." class="form-control @(ViewData.ModelState["Form.RazonSocial"]?.Errors.Count>0 ? "is-invalid" : "")" maxlength="150" required aria-describedby="razon-error" /><span id="razon-error" asp-validation-for="Form.RazonSocial" class="invalid-feedback" aria-live="polite"></span></div>
<div class="mb-3"><label class="form-label" asp-for="Form.Correo">Correo (opcional)</label><input asp-for="Form.Correo" placeholder="Ej. contacto@empresa.com" type="email" maxlength="150" class="form-control @(ViewData.ModelState["Form.Correo"]?.Errors.Count>0 ? "is-invalid" : "")" aria-describedby="correo-cliente-error" /><span id="correo-cliente-error" asp-validation-for="Form.Correo" class="invalid-feedback" aria-live="polite"></span></div>
<div class="mb-3"><label class="form-label" asp-for="Form.Telefono">Teléfono (opcional)</label><input asp-for="Form.Telefono" placeholder="Ej. 77123456" type="tel" maxlength="30" class="form-control @(ViewData.ModelState["Form.Telefono"]?.Errors.Count>0 ? "is-invalid" : "")" aria-describedby="telefono-cliente-error" /><small class="text-secondary">8 dígitos que comiencen con 4, 6 o 7.</small><span id="telefono-cliente-error" asp-validation-for="Form.Telefono" class="invalid-feedback" aria-live="polite"></span></div>
</div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-primary"><i class="bi bi-check2" aria-hidden="true"></i> @(Model.EditarId is null ? "Guardar cliente" : "Guardar cambios")</button></div></form></div></div></div>
@if(Model.EsAdministrador) {
<div class="modal fade" id="estadoClienteModal" tabindex="-1" aria-labelledby="estadoClienteTitulo" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title" id="estadoClienteTitulo">Confirmar operación</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
<form method="post" asp-page-handler="Desactivar" asp-route-Estado="@Model.Estado" asp-route-Busqueda="@Model.Busqueda" asp-route-OrdenarPor="@Model.OrdenarPor" asp-route-Descendente="@Model.Descendente" asp-route-TamanoPagina="@Model.TamanoPagina" asp-route-Pagina="@Model.Pagina" data-loading><div class="modal-body"><p>¿Confirmas <strong data-cliente-operacion></strong> a <strong data-cliente-nombre></strong>?</p><p>Los datos se conservan.</p><input type="hidden" name="id" data-cliente-id /></div><div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-primary">Confirmar</button></div></form></div></div></div>
}
@if(Model.Detalle is {} d) {
<div class="modal fade" id="clienteDetalleModal" tabindex="-1" aria-labelledby="clienteDetalleTitulo" aria-hidden="true" data-cliente-detalle-auto-open="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
<div class="modal-header"><div><span class="eyebrow">DIRECTORIO DE CLIENTES</span><h2 class="modal-title" id="clienteDetalleTitulo">Detalles del cliente</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar detalles"></button></div>
<div class="modal-body">
@if(d.EsGenerico) { <p class="badge text-bg-secondary">Cliente genérico protegido · Sin Nombre</p> }
<dl class="cliente-details"><dt>NIT/CI</dt><dd>@d.NitCi</dd><dt>Razón social</dt><dd>@d.RazonSocial</dd><dt>Correo</dt><dd>@(string.IsNullOrWhiteSpace(d.Correo) ? "No registrado" : d.Correo)</dd><dt>Teléfono</dt><dd>@(string.IsNullOrWhiteSpace(d.Telefono) ? "No registrado" : d.Telefono)</dd><dt>Estado</dt><dd>@(d.EstaActivo ? "Activo" : "Eliminado")</dd></dl>
</div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button></div>
</div></div></div>
}
<noscript><p class="alert alert-warning">Los formularios modales requieren JavaScript. El listado y la búsqueda funcionan sin él.</p></noscript>
@section Scripts {
<script type="module" src="~/js/clientes-formulario.mjs" asp-append-version="true"></script>
<script type="module" src="~/js/clientes-busqueda.mjs" asp-append-version="true"></script>
}

@section Styles { <link rel="stylesheet" href="~/css/clientes.css" asp-append-version="true" /> }
