@page
@model PuntoMarket.Frontend.Pages.Auth.ActivarModel
@{
    ViewData["Title"] = "Activar cuenta";
    ViewData["LayoutMinimo"] = true;
}
<section class="mx-auto" style="max-width: 420px;" aria-labelledby="activar-titulo">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h1 id="activar-titulo" class="h3 mb-4 text-center">Active su cuenta</h1>
            @if (Model.MensajeError is not null)
            {
                <div class="alert alert-danger" role="alert">@Model.MensajeError</div>
            }
            @if (Model.PuedeActivar)
            {
                <p>Defina su contraseña. Debe tener al menos 8 caracteres, con mayúscula, minúscula, número y un carácter especial.</p>
                <form method="post" novalidate>
                    <div class="mb-3">
                        <label for="NuevaContrasena" class="form-label">Nueva contraseña</label>
                        <input id="NuevaContrasena" name="NuevaContrasena" type="password" class="form-control" autocomplete="new-password" autofocus required />
                    </div>
                    <div class="mb-4">
                        <label for="ConfirmarContrasena" class="form-label">Confirme la contraseña</label>
                        <input id="ConfirmarContrasena" name="ConfirmarContrasena" type="password" class="form-control" autocomplete="new-password" required />
                    </div>
                    <button type="submit" class="btn btn-warning fw-semibold w-100">Activar cuenta</button>
                </form>
            }
            else
            {
                <a asp-page="/Auth/Login" class="btn btn-warning fw-semibold w-100">Ir a iniciar sesión</a>
            }
        </div>
    </div>
</section>
