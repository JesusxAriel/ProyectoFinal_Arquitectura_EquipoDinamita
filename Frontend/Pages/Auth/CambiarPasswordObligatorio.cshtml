@page
@model PuntoMarket.Frontend.Pages.Auth.CambiarPasswordObligatorioModel
@{
    ViewData["Title"] = "Cambio de contraseña obligatorio";
    ViewData["LayoutMinimo"] = true;
}
<section class="mx-auto" style="max-width: 520px;" aria-labelledby="cambio-titulo">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h1 id="cambio-titulo" class="h3 mb-3">Cambio de contraseña obligatorio</h1>
            @* Pendiente: completar la integración real del cambio de contraseña cuando esté disponible UsuariosApiAdapter.CambiarPassword. *@
            <p class="text-body-secondary">Debe cambiar su contraseña antes de continuar.</p>
            <form method="post" class="mb-3" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="PasswordActual" class="form-label">Contraseña actual</label>
                    <input asp-for="PasswordActual" type="password" class="form-control" autocomplete="current-password" required />
                    <span asp-validation-for="PasswordActual" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="PasswordNueva" class="form-label">Nueva contraseña</label>
                    <input asp-for="PasswordNueva" type="password" class="form-control" autocomplete="new-password" aria-describedby="password-requisitos" required minlength="8" />
                    <p id="password-requisitos" class="form-text">Use al menos 8 caracteres, una mayúscula, una minúscula, un número y un carácter especial.</p>
                    <span asp-validation-for="PasswordNueva" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="RepetirPasswordNueva" class="form-label">Repetir nueva contraseña</label>
                    <input asp-for="RepetirPasswordNueva" type="password" class="form-control" autocomplete="new-password" required />
                    <span asp-validation-for="RepetirPasswordNueva" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-warning fw-semibold w-100">Cambiar contraseña</button>
            </form>
            <form method="post" asp-page="/Auth/Logout">
                <button type="submit" class="btn btn-outline-secondary">Cerrar sesión</button>
            </form>
        </div>
    </div>
</section>
