@page
@model PuntoMarket.Frontend.Pages.Auth.CambiarPasswordObligatorioModel
@{
    ViewData["Title"] = "Cambio de contraseña obligatorio";
    ViewData["LayoutMinimo"] = true;
}
<section class="mx-auto" style="max-width: 520px;" aria-labelledby="cambio-titulo">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h1 id="cambio-titulo" class="h3 mb-3">Cambio de contraseña obligatorio</h1>
            <p class="text-body-secondary">Debe cambiar su contraseña antes de continuar. Esta pantalla está pendiente de implementación.</p>
            <form method="post" asp-page="/Auth/Logout">
                <button type="submit" class="btn btn-outline-secondary">Cerrar sesión</button>
            </form>
        </div>
    </div>
</section>
