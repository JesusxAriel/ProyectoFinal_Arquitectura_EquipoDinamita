@page
@model PuntoMarket.Frontend.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
    ViewData["LayoutMinimo"] = true;
}
<section class="mx-auto" style="max-width: 420px;" aria-labelledby="login-titulo">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h1 id="login-titulo" class="h3 mb-4 text-center">Iniciar sesión</h1>
            @if (Model.MensajeActivacion is not null)
            {
                <div class="alert alert-success" role="status">@Model.MensajeActivacion</div>
            }
            @if (Model.MensajeError is not null)
            {
                <div class="alert alert-danger" role="alert">@Model.MensajeError</div>
            }
            <form method="post" novalidate>
                <div class="mb-3">
                    <label asp-for="Usuario" class="form-label">Usuario</label>
                    <input asp-for="Usuario" class="form-control" autocomplete="username" autofocus />
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                </div>
                <button type="submit" class="btn btn-warning fw-semibold w-100">Ingresar</button>
            </form>
        </div>
    </div>
</section>
