@page
@model PuntoMarket.Frontend.Pages.IndexModel
@{
    ViewData["Title"] = "Inicio";
}
@if (TempData["MensajePermisos"] is string mensajePermisos)
{
    <div class="alert alert-warning shadow-sm" role="alert">@mensajePermisos</div>
}
<section class="inicio-hero mb-4" aria-labelledby="inicio-titulo">
    <span class="sale-label d-block mb-2">PuntoMarket · Gestión Comercial</span>
    <h1 id="inicio-titulo" class="display-6 fw-bold mb-3">Su punto de venta,<br />en un solo lugar.</h1>
    <p class="lead text-body-secondary mb-4">Administre sus productos, clientes y proveedores desde un entorno centralizado.</p>
    @if (User.IsInRole("Administrador") || User.IsInRole("Cajero"))
    {
        <a class="btn btn-warning fw-semibold px-4" asp-page="/Productos/Index">Ir a Productos <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i></a>
    }
</section>
<div class="row g-4">
    <div class="col-md-6">
        <section class="card sale-panel h-100">
            <div class="card-body p-4">
                <div class="inicio-icono mb-3"><i class="bi bi-box-seam" aria-hidden="true"></i></div>
                <h2 class="h4">Catálogo y Clientes</h2>
                <p class="text-body-secondary mb-0">Busque productos disponibles y mantenga actualizada la información de sus clientes.</p>
            </div>
        </section>
    </div>
    <div class="col-md-6">
        <section class="card sale-panel h-100">
            <div class="card-body p-4">
                <div class="inicio-icono mb-3"><i class="bi bi-truck" aria-hidden="true"></i></div>
                <h2 class="h4">Proveedores y Usuarios</h2>
                <p class="text-body-secondary mb-0">Gestione sus proveedores y administre los accesos del personal cuando su rol lo permita.</p>
            </div>
        </section>
    </div>
</div>
@section Styles {
    <link rel="stylesheet" href="~/css/ventas.css" asp-append-version="true" />
}