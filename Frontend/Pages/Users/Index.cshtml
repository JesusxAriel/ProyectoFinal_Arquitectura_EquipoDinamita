@page
@model PuntoMarket.Frontend.Pages.Users.IndexModel
@{ ViewData["Title"] = "Usuarios"; }

<h1 class="page-heading mb-4">Administración de usuarios</h1>

@if (Model.MensajeGestion is not null)
{
    <div class="alert alert-success shadow-sm" role="status">@Model.MensajeGestion</div>
}
@if (Model.ErrorGestion is not null)
{
    <div class="alert alert-danger shadow-sm" role="alert">@Model.ErrorGestion</div>
}

@if (Model.EditarId is not null)
{
    <section class="card shadow-sm mb-4" aria-labelledby="editarUsuarioTitulo">
        <div class="card-body">
            <h2 class="h5 card-title mb-3" id="editarUsuarioTitulo">Editar usuario</h2>
            @if (Model.UsuarioEditando is { } actual)
            {
                <p>Nombre actual: @actual.NombreCompleto</p>
                <p class="text-muted small">Vuelva a ingresar nombres y apellidos por separado para guardar el nombre completo.</p>
            }
            <form method="post" asp-page-handler="Guardar" novalidate>
                <input type="hidden" asp-for="EditarId" />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nombres" class="form-label">Nombres</label>
                        <input asp-for="Nombres" class="form-control" maxlength="150" autocomplete="given-name" required />
                        <span asp-validation-for="Nombres" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Apellidos" class="form-label">Apellidos</label>
                        <input asp-for="Apellidos" class="form-control" maxlength="150" autocomplete="family-name" required />
                        <span asp-validation-for="Apellidos" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Correo" class="form-label">Correo</label>
                        <input asp-for="Correo" type="email" class="form-control" maxlength="150" autocomplete="email" required />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="RolId" class="form-label">Rol</label>
                        <select asp-for="RolId" class="form-select" required>
                            <option value="0">Seleccione un rol</option>
                            @foreach (var rol in Model.Roles)
                            {
                                <option value="@rol.Id">@rol.Nombre</option>
                            }
                        </select>
                        <span asp-validation-for="RolId" class="text-danger"></span>
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-warning fw-semibold">Guardar cambios</button>
                    <button type="submit" asp-page-handler="CancelarEdicion" formnovalidate class="btn btn-outline-secondary">Cancelar</button>
                </div>
            </form>
        </div>
    </section>
}
else
{
    <section class="card shadow-sm mb-4" aria-labelledby="crearUsuarioTitulo">
        <div class="card-body">
            <h2 class="h5 card-title mb-3" id="crearUsuarioTitulo">Crear usuario</h2>
            <form method="post" asp-page-handler="Crear" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nombres" class="form-label">Nombres</label>
                        <input asp-for="Nombres" class="form-control" maxlength="150" autocomplete="given-name" required />
                        <span asp-validation-for="Nombres" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Apellidos" class="form-label">Apellidos</label>
                        <input asp-for="Apellidos" class="form-control" maxlength="150" autocomplete="family-name" required />
                        <span asp-validation-for="Apellidos" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Correo" class="form-label">Correo</label>
                        <input asp-for="Correo" type="email" class="form-control" maxlength="150" autocomplete="email" required />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="RolId" class="form-label">Rol</label>
                        <select asp-for="RolId" class="form-select" required>
                            <option value="0">Seleccione un rol</option>
                            @foreach (var rol in Model.Roles)
                            {
                                <option value="@rol.Id">@rol.Nombre</option>
                            }
                        </select>
                        <span asp-validation-for="RolId" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-warning fw-semibold" disabled="@(Model.Roles.Count == 0)">Crear usuario</button>
                    </div>
                </div>
            </form>
        </div>
    </section>
}

<section aria-labelledby="listadoUsuariosTitulo">
    <h2 class="h5 mb-3" id="listadoUsuariosTitulo">Listado de usuarios</h2>
    <div class="table-responsive shadow-sm rounded-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Nombre completo</th>
                    <th scope="col">Correo</th>
                    <th scope="col">Nombre de usuario</th>
                    <th scope="col">Rol</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model.Usuarios)
                {
                    <tr>
                        <td>@usuario.NombreCompleto</td>
                        <td>@usuario.Correo</td>
                        <td>@usuario.Username</td>
                        <td>@usuario.Rol</td>
                        <td>@(usuario.Activo ? "Activo" : "Inactivo")</td>
                        <td class="text-nowrap">
                            <form method="post" asp-page-handler="Editar" class="d-inline">
                                <input type="hidden" name="id" value="@usuario.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Editar</button>
                            </form>
                            @if (!string.Equals(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, usuario.Username, StringComparison.OrdinalIgnoreCase))
                            {
                                <form method="post" asp-page-handler="CambiarEstado" class="d-inline">
                                    <input type="hidden" name="id" value="@usuario.Id" />
                                    <input type="hidden" name="activo" value="@(!usuario.Activo)" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        @(usuario.Activo ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Usuarios.Count == 0 && Model.ErrorGestion is null)
    {
        <div class="alert alert-info mt-3">No hay usuarios registrados.</div>
    }
</section>
