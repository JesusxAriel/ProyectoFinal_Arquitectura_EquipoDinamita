@page
@model PuntoMarket.Frontend.Pages.Productos.IndexModel
@{ ViewData["Title"]="Productos"; }
<div class="catalogo productos">
<div class="breadcrumb-line">
<a asp-page="/Index">Inicio</a> &gt; Productos</div>
<section class="page-heading">
<div>
<span class="eyebrow">PUNTOMARKET</span>
<h1>Productos<span class="heading-dot">.</span>
</h1>
<p>Todo tu catálogo, organizado y a mano.</p>
</div>@if(Model.EsAdministrador) { <form method="post" data-loading asp-page-handler="Nuevo" asp-all-route-data="@Model.Rutas()">
<button type="submit" class="btn btn-primary">
<i class="bi bi-plus-lg" aria-hidden="true">
</i> Añadir</button>
</form> }</section>
@if(Model.Mensaje is not null) { <p class="alert alert-success" role="status">@Model.Mensaje</p> }
@if(Model.ErrorActual is not null && !Model.MostrarFormulario) { <p class="alert alert-danger" role="alert">@Model.ErrorActual</p> }
<section class="directory-card provider-directory producto-directory">
<div class="directory-top">
<div class="directory-title">
<div>
<h2>Catálogo de productos</h2>
<p>Precios y datos de tu catálogo</p>
</div>
</div>@if(!Model.EsAdministrador) { <span class="read-only">
<i class="bi bi-eye" aria-hidden="true">
</i> Solo lectura</span> }</div>
<div class="directory-controls">
<nav class="state-tabs" aria-label="Estado de productos">@foreach(var estado in new[]{"Activos","Inactivos"}) { <a class="state-tab @(Model.Estado==estado ? "active" : "")" asp-all-route-data="@Model.Rutas(1,estado)" aria-current="@(Model.Estado==estado ? "page" : null)">@estado</a> }</nav>
<span class="directory-count">@(Model.Resultado is {} lista ? $"{lista.Total} productos" : "Sin conexión")</span>
</div>
<form method="get" class="search-toolbar" data-productos-search>
    <div class="provider-search-group">
<div class="search-box">
<label class="visually-hidden" asp-for="Busqueda">Buscar código o nombre</label>
<i class="bi bi-search" aria-hidden="true">
</i>
<input asp-for="Busqueda" maxlength="150" placeholder="Buscar por código o nombre..." autocomplete="off" />
<button type="submit" class="search-submit" aria-label="Buscar">
<i class="bi bi-arrow-right" aria-hidden="true">
</i>
</button>
</div>
<button type="button" class="btn btn-primary btn-sm" data-productos-clear hidden="@(string.IsNullOrEmpty(Model.Busqueda))">Limpiar</button>
</div>
<div class="toolbar-options provider-filter-group">
    <input type="hidden" asp-for="Estado" />
<div class="provider-filter">
<label asp-for="TamanoPagina">Mostrar</label>
<select asp-for="TamanoPagina" class="form-select">@foreach(var n in new[]{10,25,50,100}) { <option value="@n">@n</option> }</select>
</div>
    <div class="provider-filter">
<label asp-for="OrdenarPor">Ordenar por</label>
<select asp-for="OrdenarPor" class="form-select">
<option value="Nombre">Nombre</option>
<option value="Codigo">Código</option>
<option value="Costo">Costo</option>
<option value="PrecioVenta">Precio de venta</option>
<option value="FechaCreacion">Fecha de creación</option>
</select>
</div>
    <div class="provider-filter">
<label asp-for="Descendente">Dirección</label>
<select asp-for="Descendente" class="form-select">
<option value="false">Ascendente</option>
<option value="true">Descendente</option>
</select>
<button class="btn btn-primary" type="submit">Buscar / recargar</button>
</div>
</div>
</form>
<div class="alert alert-danger" data-search-error role="alert" hidden>
</div>
<span class="visually-hidden" data-search-status role="status" aria-live="polite">
</span>

@if(Model.Resultado is {} resultado) {
    <div class="table-responsive">
<table class="table provider-table table-hover mb-0">
<caption class="visually-hidden">Catálogo de productos</caption>
<thead>
<tr>
<th scope="col">Código</th>
<th scope="col">Nombre</th>
<th scope="col">Costo</th>
<th scope="col">Venta</th>
<th scope="col">Estado</th>
<th scope="col">Acciones</th>
</tr>
</thead>
<tbody>
    @if(resultado.Items.Count==0) { <tr>
<td colspan="6">
<div class="empty-state">
<span>
<i class="bi bi-search" aria-hidden="true">
</i>
</span>
<h3>No hay productos para mostrar</h3>
<p>Prueba otra búsqueda o revisa el estado seleccionado.</p>
</div>
</td>
</tr> }
    @foreach(var p in resultado.Items) {
        <tr>
<td>@p.Codigo</td>
<td>@p.Nombre</td>
<td>@p.Costo.ToString("N2")</td>
<td>@p.PrecioVenta.ToString("N2")</td>
<td>@(p.EstaActivo?"Activo":"Inactivo")</td>
<td>
<div class="row-actions">
        <form method="post" data-loading asp-page-handler="Detalle" asp-all-route-data="@Model.Rutas()" class="catalogo-action">
<input type="hidden" name="id" value="@p.Id" />
<button type="submit" class="icon-button" title="Ver detalles de @p.Nombre" aria-label="Ver detalles de @p.Nombre">
<i class="bi bi-eye" aria-hidden="true">
</i>
</button>
</form>
@if(Model.EsAdministrador && p.EstaActivo) {
            <form method="post" data-loading asp-page-handler="Editar" asp-all-route-data="@Model.Rutas()" class="d-inline">
<input type="hidden" name="id" value="@p.Id" />
<button type="submit" class="icon-button edit-button" title="Editar @p.Nombre" aria-label="Editar @p.Nombre">
<i class="bi bi-pencil-square" aria-hidden="true">
</i>
</button>
</form>
            <button type="button" class="icon-button delete-button" data-bs-toggle="modal" data-bs-target="#eliminarModal" data-id="@p.Id" data-nombre="@p.Nombre" title="Eliminar @p.Nombre" aria-label="Eliminar @p.Nombre">
<i class="bi bi-trash" aria-hidden="true">
</i>
</button>
        }
        </div>
</td>
</tr>
    }
    </tbody>
</table>
</div>
<div class="table-footer">
<span>@resultado.Total productos · Página @Model.Pagina de @Math.Max(1,resultado.TotalPaginas)</span>
<nav aria-label="Paginación de productos">
<ul class="pagination mb-0">
<li class="page-item @(Model.Pagina<=1 ? "disabled" : "")">
<a class="page-link" asp-all-route-data="@Model.Rutas(Math.Max(1,Model.Pagina-1))" aria-label="Página anterior" tabindex="@(Model.Pagina<=1 ? -1 : 0)">Anterior</a>
</li>
@for(var n=Math.Max(1,Model.Pagina-2);n<=Math.Min(resultado.TotalPaginas,Model.Pagina+2);n++) { <li class="page-item @(n==Model.Pagina ? "active" : "")">
<a class="page-link" asp-all-route-data="@Model.Rutas(n)" aria-current="@(n==Model.Pagina ? "page" : null)">@n</a>
</li> }
<li class="page-item @(Model.Pagina>=resultado.TotalPaginas ? "disabled" : "")">
<a class="page-link" asp-all-route-data="@Model.Rutas(Model.Pagina+1)" aria-label="Página siguiente" tabindex="@(Model.Pagina>=resultado.TotalPaginas ? -1 : 0)">Siguiente</a>
</li>
</ul>
</nav>
</div>
}

@if(Model.Resultado is null) { <div class="table-responsive">
<div class="empty-state">
<span>
<i class="bi bi-cloud-slash" aria-hidden="true">
</i>
</span>
<h3>No pudimos cargar los productos</h3>
<p>Comprueba la conexión e inténtalo de nuevo.</p>
<a class="btn btn-outline-secondary" asp-all-route-data="@Model.Rutas()">Reintentar</a>
</div>
</div> }
</section>
@if(Model.MostrarFormulario && Model.EsAdministrador) {
    <div class="modal fade @(Model.EditarId.HasValue ? "" : "producto-creacion")" id="productoModal" tabindex="-1" aria-labelledby="productoTitulo" aria-hidden="true" data-auto-open="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title" id="productoTitulo">@(Model.EditarId.HasValue ? "Editar producto" : "Añadir producto")</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form method="post" data-loading asp-page-handler="Guardar" asp-all-route-data="@Model.Rutas()">
                    <div class="modal-body">
                        @if(Model.ErrorActual is not null) { <div class="alert alert-danger" role="alert">@Model.ErrorActual</div> }
                        @if(ViewData.ModelState.ErrorCount>0) { <div asp-validation-summary="All" class="text-danger" role="alert"></div> }
                        <p class="form-intro">* Campos obligatorios.</p>
                        <input type="hidden" asp-for="EditarId" />
                        <div class="producto-campos">
                            <div class="producto-campo">
                                <label class="form-label mt-3" asp-for="Form.Codigo">Código *</label>
                                <input asp-for="Form.Codigo" required class="form-control" maxlength="50" aria-describedby="producto-Codigo-error" />
                                <span id="producto-Codigo-error" asp-validation-for="Form.Codigo" class="text-danger" aria-live="polite"></span>
                            </div>
                            <div class="producto-campo">
                                <label class="form-label mt-3" asp-for="Form.Nombre">Nombre *</label>
                                <input asp-for="Form.Nombre" required class="form-control" maxlength="150" aria-describedby="producto-Nombre-error" />
                                <span id="producto-Nombre-error" asp-validation-for="Form.Nombre" class="text-danger" aria-live="polite"></span>
                            </div>
                            <div class="producto-campo">
                                <label class="form-label mt-3" asp-for="Form.Costo">Costo *</label>
                                <input asp-for="Form.Costo" required class="form-control" type="number" step="0.01" min="0.01" aria-describedby="producto-Costo-error" />
                                <span id="producto-Costo-error" asp-validation-for="Form.Costo" class="text-danger" aria-live="polite"></span>
                            </div>
                            <div class="producto-campo">
                                <label class="form-label mt-3" asp-for="Form.PrecioVenta">Precio de venta *</label>
                                <input asp-for="Form.PrecioVenta" required class="form-control" type="number" step="0.01" min="0.01" aria-describedby="producto-PrecioVenta-error" />
                                <span id="producto-PrecioVenta-error" asp-validation-for="Form.PrecioVenta" class="text-danger" aria-live="polite"></span>
                            </div>
                            <div class="producto-campo ">
                                <label class="form-label mt-3" asp-for="Form.CategoriaId">Categoría *</label>
                                <select asp-for="Form.CategoriaId" required class="form-select" aria-describedby="producto-CategoriaId-error">
                                    <option value="">Seleccione</option>
                                    @foreach(var item in Model.Catalogos?.Categorias ?? []) { <option value="@item.Id">@item.Nombre</option> }
                                </select>
                                <span id="producto-CategoriaId-error" asp-validation-for="Form.CategoriaId" class="text-danger" aria-live="polite"></span>
                            </div>
                            <div class="producto-campo ">
                                <label class="form-label mt-3" asp-for="Form.EmpaqueId">Empaque *</label>
                                <select asp-for="Form.EmpaqueId" required class="form-select" aria-describedby="producto-EmpaqueId-error">
                                    <option value="">Seleccione</option>
                                    @foreach(var item in Model.Catalogos?.Empaques ?? []) { <option value="@item.Id">@item.Nombre</option> }
                                </select>
                                <span id="producto-EmpaqueId-error" asp-validation-for="Form.EmpaqueId" class="text-danger" aria-live="polite"></span>
                            </div>
                            <div class="producto-campo producto-campo-completo">
                                <label class="form-label mt-3" asp-for="Form.ProveedorId">Proveedor activo *</label>
                                <select asp-for="Form.ProveedorId" required class="form-select" aria-describedby="producto-ProveedorId-error">
                                    <option value="">Seleccione</option>
                                    @foreach(var item in Model.Proveedores) { <option value="@item.Id">@item.NombreEmpresa</option> }
                                </select>
                                <span id="producto-ProveedorId-error" asp-validation-for="Form.ProveedorId" class="text-danger" aria-live="polite"></span>
                            </div>
                        </div>
                        @if(Model.EditarId.HasValue) {
                            <label class="form-label mt-3" asp-for="Form.MotivoCambioPrecio">Motivo del cambio de precio</label>
                            <input data-precio-original="@Model.PrecioOriginal?.ToString(System.Globalization.CultureInfo.InvariantCulture)" asp-for="Form.MotivoCambioPrecio" class="form-control" maxlength="250" aria-describedby="producto-motivo-ayuda" />
                            <small id="producto-motivo-ayuda">Obligatorio únicamente si cambia el precio de venta.</small>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">@(Model.EditarId.HasValue ? "Guardar cambios" : "Añadir producto")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if(Model.EsAdministrador) { <div class="modal fade" id="eliminarModal" tabindex="-1" aria-labelledby="eliminarTitulo" aria-hidden="true">
<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
<div class="modal-content">
<div class="modal-header">
<h2 class="modal-title" id="eliminarTitulo">Eliminar producto</h2>
<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar">
</button>
</div>
<form method="post" data-loading asp-page-handler="Desactivar" asp-all-route-data="@Model.Rutas()">
<div class="modal-body">
<span class="confirmation-icon">
<i class="bi bi-trash" aria-hidden="true">
</i>
</span>
<p>¿Quieres eliminar el producto <strong data-delete-name>
</strong>?</p>
<p>El producto pasará a Inactivos. Sus datos e historial de precios se conservarán.</p>
<input type="hidden" name="id" data-delete-id />
</div>
<div class="modal-footer">
<button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
<button type="submit" class="btn btn-danger">Eliminar producto</button>
</div>
</form>
</div>
</div>
</div> }
@if(Model.Detalle is {} d) { <div class="modal fade" id="productoDetalleModal" tabindex="-1" aria-labelledby="detalleTitulo" aria-hidden="true" data-auto-open="true">
<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
<div class="modal-content">
<div class="modal-header">
<h2 class="modal-title" id="detalleTitulo">Detalles del producto</h2>
<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar">
</button>
</div>
<div class="modal-body">
<dl class="catalogo-details">
<dt>Código</dt>
<dd>@d.Codigo</dd>
<dt>Nombre</dt>
<dd>@d.Nombre</dd>
<dt>Costo</dt>
<dd>@d.Costo.ToString("N2")</dd>
<dt>Precio de venta</dt>
<dd>@d.PrecioVenta.ToString("N2")</dd>
<dt>Categoría</dt>
<dd>@(Model.Catalogos?.Categorias.FirstOrDefault(c=>c.Id==d.CategoriaId)?.Nombre ?? d.CategoriaId.ToString())</dd>
<dt>Empaque</dt>
<dd>@(Model.Catalogos?.Empaques.FirstOrDefault(c=>c.Id==d.EmpaqueId)?.Nombre ?? d.EmpaqueId.ToString())</dd>
<dt>Proveedor</dt>
<dd>@(Model.Proveedores.FirstOrDefault(p=>p.Id==d.ProveedorId)?.NombreEmpresa ?? d.ProveedorId)</dd>
<dt>Estado</dt>
<dd>@(d.EstaActivo ? "Activo" : "Inactivo")</dd>
<dt>Creación</dt>
<dd>@d.FechaCreacion.ToString("g")</dd>
<dt>Creado por</dt>
<dd>@d.IdUsuarioCreacion</dd>@if(d.FechaActualizacion is {} fecha) { <dt>Actualización</dt>
<dd>@fecha.ToString("g")</dd>
<dt>Actualizado por</dt>
<dd>@d.IdUsuarioActualizacion</dd> }</dl>
</div>
<div class="modal-footer">
<button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
</div>
</div>
</div>
</div> }
<noscript>
<p class="alert alert-warning">Activa JavaScript para utilizar los modales. El listado y la búsqueda siguen disponibles.</p>
</noscript>
</div>
@section Styles { <link rel="stylesheet" href="~/css/catalogos.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/productos.css" asp-append-version="true" /> }
@section Scripts { <script type="module" src="~/js/productos-busqueda.mjs" asp-append-version="true">
</script>
<script src="~/js/productos-formulario.js" asp-append-version="true">
</script>
<script type="module" src="~/js/catalogos-modales.mjs" asp-append-version="true">
</script> }
