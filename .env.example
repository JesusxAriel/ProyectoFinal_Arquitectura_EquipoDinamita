# Opcional: copiar a .env solo para cambiar puertos. No contiene contraseñas.
# Los valores predeterminados permiten docker compose up --build -d sin copiar este archivo.
FRONTEND_PORT=5100
GATEWAY_PORT=5000
PROVEEDORES_API_PORT=5200
DEV_IDENTITY_PORT=5300
# MongoDB Docker separado del servidor Windows (27017).
MONGO_PORT=27018
