{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "proveedores-route": {
        "ClusterId": "proveedores-cluster",
        "Match": { "Path": "/api/proveedores/{**catch-all}" }
      },
      "proveedores-raiz-route": {
        "ClusterId": "proveedores-cluster",
        "Match": { "Path": "/api/proveedores" }
      },
      "dev-auth-route": {
        "ClusterId": "dev-identity-cluster",
        "Match": { "Path": "/dev-auth/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/dev-auth" } ]
      }
    },
    "Clusters": {
      "proveedores-cluster": {
        "Destinations": {
          "proveedores-api": { "Address": "http://localhost:5200/" }
        }
      },
      "dev-identity-cluster": {
        "Destinations": {
          "dev-identity": { "Address": "http://localhost:5300/" }
        }
      }
    }
  }
}
